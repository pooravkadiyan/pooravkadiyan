{
  "ci": {
    "collect": {
      "numberOfRuns": 1,
      "startServerCommand": "npm run dev -- --port 3100",
      "startServerReadyPattern": "Ready in",
      "url": [
        "http://127.0.0.1:3100/",
        "http://127.0.0.1:3100/work",
        "http://127.0.0.1:3100/engage"
      ],
      "settings": {
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 390,
          "height": 844,
          "deviceScaleFactor": 2
        },
        "throttlingMethod": "simulate",
        "chromeFlags": "--headless=new --no-sandbox --disable-dev-shm-usage"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "warn",
          {
            "minScore": 0.65
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": [
          "warn",
          {
            "minScore": 0.9
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci-mobile"
    }
  }
}
